{
	admin off
	persist_config off
	storage file_system {
		root {$SITE_STORAGE:.codex-temp/caddy-storage}
	}
}

{$SITE_ADDRESS:http://127.0.0.1:1467} {
	bind {$SITE_BIND:127.0.0.1}
	root * {$SITE_ROOT:.codex-temp/site-dist}
	encode gzip

	route {
		header Cache-Control "no-cache"
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		@existing file {path}
		handle @existing {
			file_server
		}
		@demo path /demo /demo/*
		handle @demo {
			rewrite * /demo/index.html
			file_server
		}
		@website path / /zh /zh/ /en /en/ /documentation /documentation/ /zh/documentation /zh/documentation/ /en/documentation /en/documentation/ /zh/demo /zh/demo/ /en/demo /en/demo/
		handle @website {
			rewrite * /index.html
			file_server
		}
		handle {
			rewrite * /index.html
			file_server {
				status 404
			}
		}
	}
}
