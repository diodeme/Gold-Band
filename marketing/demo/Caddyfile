{
	admin off
	persist_config off
	storage file_system {
		root {$DEMO_STORAGE:.codex-temp/caddy-demo-storage}
	}
}

{$DEMO_ADDRESS:http://127.0.0.1:1468} {
	bind {$DEMO_BIND:127.0.0.1}
	root * {$DEMO_ROOT:.codex-temp/demo-dist}
	encode gzip
	route {
		header Cache-Control "no-cache"
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			file_server
		}
	}
}
