y($name) -or [string]::IsNullOrWhiteSpace($values[$name])){ throw \"required SSH setting is unavailable: $name\" } }; try { @'\nset -eu\nroot=\"$HOME/.local/share/ji-host\"\nprintf 'SERVICE_ACTIVE=%s\\n' \"$(systemctl --user is-active ji-host.service)\"\nprintf 'SERVICE_ENABLED=%s\\n' \"$(systemctl --user is-enabled ji-host.service)\"\ntarget=$(readlink \"$root/current\")\nprintf 'CURRENT_FINAL=%s\\n' \"$(test \"$target\" = \"$root/versions/0.1.0-SNAPSHOT/ji-host\" && printf true || printf false)\"\ntest -f \"$root/run/host-locator\"\nrest=$(sed -n 's/^rest=//p' \"$root/run/host-locator\")\n\"$root/current/bin/ji-host\" --health-check \"http://127.0.0.1:$rest/api/v1/health/ready\"\nprintf 'CURRENT_READY=true\\n'\npython3 - <<'PY'\nimport json, os\np=os.path.expanduser('~/.local/share/ji-host/data/host-identity.json')\nwith open(p, encoding='utf-8') as f: v=json.load(f)\nd=v.get('devices', [])\nprint('IDENTITY_FORMAT_OK='+str(v.get('format')=='ji-host-identity-v1').lower())\nprint('IDENTITY_ALGORITHM_OK='+str(v.get('hostIdentityAlgorithm')=='Ed25519').lower())\nprint('IDENTITY_REVISION_PRESENT='+str(isinstance(v.get('revision'), int)).lower())\nprint('DEVICE_COUNT='+str(len(d)))\nprint('DEVICE_ALGORITHMS_OK='+str(all(x.get('authAlgorithm')=='Ed25519' for x in d)).lower())\nprint('DEVICE_REVISIONS_PRESENT='+str(all(isinstance(x.get('revision'), int) for x in d)).lower())\nPY\nprintf 'PRE_MIGRATION_BACKUPS=%s\\n' \"$(find \"$root/data\" -type f -name '*.pre-v*.backup' | wc -l)\"\nop=$(find \"$root/operations\" -maxdepth 1 -type d -name 'install-0.1.0-SNAPSHOT-*' | LC_ALL=C sort | tail -n 1)\ntest -n \"$op\"\nprintf 'FINAL_OPERATION_COMPLETE=%s\\n' \"$(test -f \"$op/complete\" && printf true || printf false)\"\nprintf 'FINAL_INVENTORY_MATCH=%s\\n' \"$(cmp -s \"$op/expected-files\" \"$op/actual-files\" && printf true || printf false)\"\nprintf 'FAILED_HEALTH_OPERATIONS=%s\\n' \"$(find \"$root/operations\" -maxdepth 1 -type d -name 'install-0.1.0-stage6-failed-health-*' | wc -l)\"\nprintf 'ROLLBACK_TEMP_MARKERS=%s\\n' \"$(find \"$root\" -maxdepth 3 \\( -name '*.rollback' -o -name '*.reset' -o -name '*.restore' \\) | wc -l)\"\n'@ | ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -i $values['JI_TEST_SSH_KEY'] $values['JI_TEST_SSH_TARGET']; if($LASTEXITCODE -ne 0){exit $LASTEXITCODE} } finally { $values.Clear() }","status":"completed","toolCallId":"exec-5547cc86-37bb-4a6b-bfdd-f320dea54168","sessionId":"01a07b54-903c-7a22-bd7e-5bf1fb5fa805","seq":47715,"startedSeq":47702,"endedSeq":47715,"timestamp":"1788777415Z","raw":{"_meta":{"goldBandConversation":{"branchId":"root","toolName":null,"toolDetailAvailable":false}}}},{"id":"assistant-thought-root-rs_02caeff869c4892e016a9e93cd4e3087d0a7d8f5533fb5d184","kind":"thoughtDelta","sessionId":"01a07b54-903c-7a22-bd7e-5bf1fb5fa805","seq":47718,"startedSeq":47717,"endedSeq":47718,"timestamp":"1788777425Z","raw":{"_meta":{"goldBandConversation":{"branchId":"root","toolName":null,"toolDetailAvailable":false}}},"content":"\n\n**Inspecting identity migration fields**"},{"id":"assistant-thought-root-rs_02caeff869c4892e016a9e93d1256087d0a1b6ba41398a662d","kind":"thoughtDelta","sessionId":"01a07b54-903c-7a22-bd7e-5bf1fb5fa805","seq":47720,"startedSeq":47719,"endedSeq":47720,"timestamp":"1788777426Z","raw":{"_meta":{"goldBandConversation":{"branchId":"root","toolName":null,"toolDetailAvailable":false}}},"content":"\n\n**Investigating legacy algorithm field requirement**"},{"id":"assistant-message-root-msg_02caeff869c4892e016a9e93d28cc887d085d9222c5593716d","kind":"textDelta","sessionId":"01a07b54-903c-7a22-bd7e-5bf1fb5fa805","seq":47839,"startedSeq":47721,"endedSeq":47839,"timestamp":"1788777426Z","raw":{"_meta":{"goldBandConversation":{"branchId":"root","toolName":null,"toolDetailAvailable":false}}},"content":"远端最终状态的独立只读复核没有支持交接结论：服务和当前 `0.1.0-SNAPSHOT` Host 确实健康，且有 2 份 pre-migration backup、最终 inventory 相符；但持久 identity 仍缺少预期的 Host algorithm/revision，配对设备也未满足 algorithm 检查，最终安装 operation 没有 `complete`，