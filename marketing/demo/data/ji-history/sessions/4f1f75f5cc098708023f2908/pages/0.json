shot 仅在第 500 个事件或活跃 5 分钟推进，并确保窗口外 replay 发送最近 snapshot。先修改共享 TCK，而不是在实现里恢复错误的 per-event snapshot。","startedSeq":4858,"endedSeq":4993,"startedAt":"1788621933Z","endedAt":"1788621935Z","timing":{"sessionElapsedSeconds":4489,"revision":4993,"observedAt":"1788621935Z","activeTurnStartedAt":"1788619517Z","activeTurnLastActivityAt":"1788621935Z","paused":false,"reason":"active","stateSnapshot":{"elapsedSeconds":2071,"activeTurnStartedAt":1788619517,"activeTurnLastActivityAt":1788621935,"revision":4993,"sawTurn":true,"pendingPermissionIds":[],"pendingElicitationIds":[],"userWaitStartedAt":null,"userWaitSeconds":0}},"raw":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"。"},"messageId":"resp_05a05faa867c9051016a9c34660ef487d0820ef636558e2297","_meta":{"goldBandConversation":{"branchId":"root","launchedAgentExecutionId":null,"toolName":null,"toolOutput":null}}}},{"id":"activity-4994","seq":4994,"timestamp":"1788621936Z","kind":"activitySummary","title":"Read ji-java\\applications\\ji-host-core\\src\\testFixtures\\java\\io\\github\\diodeme\\ji\\host\\HostStoreTck.java (1 - 370)","status":"completed","startedSeq":4994,"endedSeq":4997,"startedAt":"1788621936Z","endedAt":"1788621937Z","raw":{"goldBandActivity":{"activityStartSeq":4994,"activityEndSeq":4997,"totalEventCount":1,"toolCallCount":1,"thoughtCount":0,"errorCount":0,"readFileCount":1,"writtenFileCount":0,"detailAvailable":true}}},{"id":"context-compaction-4999","seq":5002,"timestamp":"1788621937Z","kind":"contextCompaction","sessionId":"a4b4e6f4-8ab1-40bb-9a88-ff8aa798e2cc","status":"completed","startedSeq":4999,"endedSeq":5000,"startedAt":"1788621937Z","endedAt":"1788622168Z","timing":{"sessionElapsedSeconds":4723,"revision":5002,"observedAt":"1788622169Z","activeTurnStartedAt":"1788619517Z","activeTurnLastActivityAt":"1788622169Z","paused":false,"reason":"active","stateSnapshot":{"elapsedSeconds":2071,"activeTurnStartedAt":1788619517,"activeTurnLastActivityAt":1788622169,"revision":5002,"sawTurn