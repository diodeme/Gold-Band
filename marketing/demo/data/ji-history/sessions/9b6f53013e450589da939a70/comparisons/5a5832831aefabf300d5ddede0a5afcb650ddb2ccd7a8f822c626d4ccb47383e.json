[REDACTED_CREDENTIAL]\" \")}</span><div><Button variant=\"ghost\" disabled={index === 0} aria-label={`Move ${item.content.join(\" \")} up`} onClick={() => void queueAction(\"reorder\", undefined, move(queue.map(value => value.itemId), index, index - 1))}>Up</Button><Button variant=\"ghost\" disabled={index === queue.length - 1} aria-label={`Move ${item.content.join(\" \")} down`} onClick={() => void queueAction(\"reorder\", undefined, move(queue.map(value => value.itemId), index, index + 1))}>Down</Button><Button variant=\"ghost\" onClick={() => void queueAction(\"promote\", item.itemId)}>Steer</Button><Button variant=\"ghost\" onClick={() => void queueAction(\"remove\", item.itemId)}>Edit</Button></div></div>)}{queuePaused && <Button onClick={() => void queueAction(\"resume\")}>Resume queue</Button>}</section>}\n    <div className=\"config\" aria-label=\"Composer configuration\">\n      <Select value={config?.profileId ?? \"\"} onValueChange={value => void changeProfile(value)} disabled={!config || profiles.isLoading}><SelectTrigger aria-label={t(\"providerProfiles\")}><SelectValue /></SelectTrigger><SelectContent>{profileList.map(profile => <SelectItem key=[REDACTED_CREDENTIAL] value={profile.profileId}>{profile.profileId}</SelectItem>)}</SelectContent></Select>\n      <Select value={config?.modelId ?? \"\"} onValueChange={value => void changeModel(value)} disabled={!config}><SelectTrigger aria-label={t(\"defaultModel\")}><SelectValue /></SelectTrigger><SelectContent>{profileList.find(profile => profile.profileId === config?.profileId)?.models.map(model => <SelectItem key=[REDACTED_CREDENTIAL] value={model.modelId}>{model.displayName}</SelectItem>)}</SelectContent></Select>\n      <Select value={config?.reasoning ?? \"default\"} onValueChange={value => void changeConfig(\"reasoning\", value)}><SelectTrigger aria-label={t(\"reasoning\")}><SelectValue /></SelectTrigger><SelectContent><SelectItem value=\"default\">{t(\"reasoningDefault\")}</SelectItem><SelectItem value=\"low\">{t(\"reasoningLow\")}</SelectItem><SelectItem value=\"high\">{t(\"reasoningHigh\")}</SelectItem></SelectContent></Select>\n      <Select value={config?.permissionMode ?? \"ask\"} onValueChange={value => void changeConfig(\"permissionMode\", value)}><SelectTrigger aria-label={t(\"permissionMode\")}><SelectValue /></SelectTrigger><SelectContent><SelectItem value=\"ask\">{t(\"askPermissions\")}</SelectItem><SelectItem value=\"deny\">{t(\"denyTools\")}</SelectItem></SelectContent></Select>"},"limitationCode":"turn-files.non-linear-mutation"}