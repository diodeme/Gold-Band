{"changeSetId":"turn-files-b4222c706ca6a1e736aa62fa78e8e5d8","changeId":"turn-file-change-7f99d9bf8a4a64522b12b770fe449286","path":"E:/Projects/Code/AI/Ji/ji-java/web/app/src/App.tsx","stats":{"addedLines":20,"deletedLines":9},"before":{"version":{"id":"captured-232c6db53526b17c0b8744700852f8205f6a967dba2f32acbdf5679a68f0ac50","storageKind":"capturedBlob","contentHash":"232c6db53526b17c0b8744700852f8205f6a967dba2f32acbdf5679a68f0ac50","byteLength":865,"encoding":"utf-8","lineEnding":"lf"},"content":"function ResourcesPage() {\n  const { t } = useI18n()\n  const { tab = \"context-files\" } = useParams()\n  const values = [\"context-files\", \"skills\", \"prompt-templates\", \"extensions\", \"project-trust\"] as const\n  const labels = { \"context-files\": t(\"contextFiles\"), skills: t(\"skills\"), \"prompt-templates\": t(\"promptTemplates\"), extensions: t(\"extensions\"), \"project-trust\": t(\"projectTrust\") }\n  return <Page title={t(\"resources\")} eyebrow={t(\"localWorkspace\")}><Tabs value={tab}><TabsList>{values.map(value => <TabsTrigger key=[REDACTED_CREDENTIAL] value={value} asChild><Link to={`../${value}`}>{labels[value]}</Link></TabsTrigger>)}</TabsList>{values.map(value => <TabsContent key=[REDACTED_CREDENTIAL] value={value}><h2>{labels[value]}</h2><p>{t(\"resourceEmpty\", { name: labels[value].toLowerCase() })}</p></TabsContent>)}</Tabs></Page>\n}\n\nfunction SettingsPage({ scope }: { scope: string }) {"},"after":{"version":{"id":"captured-2063c9358cdcbcd22bc8665071bc0a6400313af540221299cfee09fd5bf870c9","storageKind":"capturedBlob","contentHash":"2063c9358cdcbcd22bc8665071bc0a6400313af540221299cfee09fd5bf870c9","byteLength":5290,"encoding":"utf-8","lineEnding":"lf"},"content":"    <label>{t(\"credentialId\")}<input aria-label={`${profile.profileId} ${t(\"credentialId\")}`} required value={profile.credential.credentialId} onChange={event => setProfile(value => ({ ...value, credential: { ...value.credential, credentialId: event.target.value } }))} /></label>\n    <label>{t(\"credentialType\")}<Select value={profile.credential.type} onValueChange={type => setProfile(value => ({ ...value, credential: { ...value.credential, type } }))}><SelectTrigger aria-label={`${profile.profileId} ${t(\"credentialType\")}`}><SelectValue /></SelectTrigger><SelectContent>{[\"none\", \"api_key\", \"bearer_token\", \"oauth\", \"cloud\", \"custom_service\"].map(type => <SelectItem key=[REDACTED_CREDENTIAL] value={type}>{title(type)}</SelectItem>)}</SelectContent></Select></label>\n    <label>{t(\"defaultModel\")}<Select value={defaultModel} onValueChange={model => setProfile(value => ({ ...value, defaultModel: model }))}><SelectTrigger aria-label={`${profile.profileId} ${t(\"defaultModel\")}`}><SelectValue /></SelectTrigger><SelectContent>{profile.models.map(model => <SelectItem key=[REDACTED_CREDENTIAL] value={model.modelId}>{model.displayName}</SelectItem>)}</SelectContent></Select></label>\n    <label>{t(\"profileSettings\")}<textarea aria-label={`${profile.profileId} ${t(\"profileSettings\")}`} value={settingsText} onChange={event => setSettingsText(event.target.value)} placeholder={t(\"jsonObjectHint\")} /></label>\n    <fieldset className=\"profile-collection\"><legend>{t(\"models\")}</legend>{profile.models.map((model, index) => <div className=\"model-editor\" key=[REDACTED_CREDENTIAL]\n      <label>{t(\"modelId\")}<input aria-label={`${model.modelId} ${t(\"modelId\")}`} required value={model.modelId} onChange={event => { const before = model.modelId; const next = event.target.value; updateModel(index, { modelId: next }); setModelSettings(value => ({ ...value, [next]: value[before] ?? \"{}\" })) }} /></label>\n      <label>{t(\"displayName\")}<input aria-label={`${model.modelId} ${t(\"displayName\")}`} required value={model.displayName} onChange={event => updateModel(index, { displayName: event.target.value })} /></label>\n      <label>{t(\"capabilities\")}<input aria-label={`${model.modelId} ${t(\"capabilities\")}`} value={model.capabilities.join(\", \")} onChange={event => updateModel(index, { capabilities: event.target.value.split(\",\").map(value => value.trim()).filter(Boolean) })} /></label>\n      <label>{t(\"modelSettings\")}<textarea aria-label={`${model.modelId} ${t(\"modelSettings\")}`} value={modelSettings[model.modelId] ?? \"{}\"} onChange={event => setModelSettings(value => ({ ...value, [model.modelId]: event.target.value }))} /></label>\n      <Button type=\"button\" variant=\"outline\" disabled={profile.models.length === 1} onClick={() => setProfile(value => ({ ...value, models: value.models.filter((_, current) => current !== index) }))}>{t(\"removeModel\")}</Button>\n    </div>)}<Button type=\"button\" variant=\"outline\" onClick={() => { const id = `model-${profile.models.length + 1}`; setProfile(value => ({ ...value, models: [...value.models, { modelId: id, displayName: id, capabilities: [\"text\"], settings: {} }] })); setModelSettings(value => ({ ...value, [id]: \"{}\" })) }}>{t(\"addModel\")}</Button></fieldset>\n    <fieldset className=\"profile-collection\"><legend>{t(\"customHeaders\")}</legend>{headers.map(([name, credential], index) => <div className=\"header-editor\" key=[REDACTED_CREDENTIAL]\n      <label>{t(\"headerName\")}<input aria-label={`Header ${index + 1} name`} value={name} onChange={event => renameHeader(index, event.target.value)} /></label>\n      <label>{t(\"credentialId\")}<input aria-label={`Header ${index + 1} credential ID`} value={credential.credentialId} onChange={event => setProfile(value => ({ ...value, headerCredentials: { ...value.headerCredentials, [name]: { ...credential, credentialId: event.target.value } } }))} /></label>\n      <label>{t(\"credentialType\")}<Select value={credential.type} onValueChange={type => setProfile(value => ({ ...value, headerCredentials: { ...value.headerCredentials, [name]: { ...credential, type } } }))}><SelectTrigger aria-label={`Header ${index + 1} ${t(\"credentialType\")}`}><SelectValue /></SelectTrigger><SelectContent>{[\"none\", \"api_key\", \"bearer_token\", \"oauth\", \"cloud\", \"custom_service\"].map(type => <SelectItem key=[REDACTED_CREDENTIAL] value={type}>{title(type)}</SelectItem>)}</SelectContent></Select></label>\n      <Button type=\"button\" variant=\"outline\" onClick={() => setProfile(value => ({ ...value, headerCredentials: Object.fromEntries(Object.entries(value.headerCredentials).filter((_, current) => current !== index)) }))}>{t(\"removeHeader\")}</Button>\n    </div>)}<Button type=\"button\" variant=\"outline\" onClick={() => setProfile(value => ({ ...value, headerCredentials: { ...value.headerCredentials, \"\": { credentialId: \"none\", type: \"none\" } } }))}>{t(\"addHeader\")}</Button></fieldset>\n    <div className=\"profile-actions\"><span>{profile.models.length} {t(\"models\")} · {Object.keys(profile.headerCredentials).length} {t(\"customHeaders\")}</span><Button type=\"submit\" disabled={status === \"saving\" || !defaultModel}>{t(\"saveProfile\")}</Button></div>\n    {profile.baseUrl.startsWith(\"http:\") && <p className=\"warning\">{t(\"httpWarning\")}</p>}\n    {status === \"error\" && <p role=\"alert\" className=\"error\">{t(\"profileSaveError\")}</p>}"},"limitationCode":"turn-files.non-linear-mutation"}