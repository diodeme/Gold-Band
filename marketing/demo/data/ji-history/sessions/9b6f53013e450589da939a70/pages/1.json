 -c` 只绑定首段、输出形状不稳定。修复 transport 边界为对完整脚本做单一 shell quoting，并补测试；这同时避免后续 activation/service 脚本被同类拆分。另将验证入口从 Gradle `--args` 改为不回显参数的直接 Java classpath 启动，防止 target/key 路径进入构建日志。","startedSeq":7966,"endedSeq":8111,"startedAt":"1788582113Z","endedAt":"1788582116Z","timing":{"sessionElapsedSeconds":7982,"revision":8111,"observedAt":"1788582116Z","activeTurnStartedAt":"1788578588Z","activeTurnLastActivityAt":"1788582116Z","paused":false,"reason":"active","stateSnapshot":{"elapsedSeconds":4454,"activeTurnStartedAt":1788578588,"activeTurnLastActivityAt":1788582116,"revision":8111,"sawTurn":true,"pendingPermissionIds":[],"pendingElicitationIds":[],"userWaitStartedAt":null,"userWaitSeconds":0}},"raw":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"。"},"messageId":"resp_0d74c6fc1e492156016a9b98cdc18087d0ba3577104c330a63","_meta":{"goldBandConversation":{"branchId":"root","launchedAgentExecutionId":null,"toolName":null,"toolOutput":null}}}},{"id":"activity-8113","seq":8113,"timestamp":"1788582116Z","kind":"activitySummary","startedSeq":8113,"endedSeq":8147,"startedAt":"1788582116Z","endedAt":"1788582169Z","raw":{"goldBandActivity":{"activityStartSeq":8113,"activityEndSeq":8147,"totalEventCount":5,"toolCallCount":4,"thoughtCount":1,"errorCount":0,"readFileCount":0,"writtenFileCount":2,"detailAvailable":true}}},{"id":"assistant-message-root-resp_0ac2075121f49a39016a9b990ae09887d0bfebce6643c00c3a","seq":8206,"timestamp":"1788582169Z","kind":"textDelta","sessionId":"b3c3636e-0f88-425f-958f-919984f20e84","content":"SSH transport quoting回归已通过。先更新仓库内 Remote 验证脚本，使 Gradle 只构建 distribution、实际参数由启动脚本直接接收，不再出现在 Gradle task graph 日志；随后用同一签名 bundle重试真实安装。","startedSeq":8148,"endedSeq":8206,"startedAt":"1788582169Z","endedAt":"1788582171Z","timing":{"sessionElapsedSeconds":8037,"revision":8206,"observedAt":"1788582171Z","activeTurnStartedAt":"1788578588Z","activeTurnLastActivityAt":"1788582171Z","paused":false,"reason":"active","stateSnapshot":{"elapsedSeconds":4454,"a