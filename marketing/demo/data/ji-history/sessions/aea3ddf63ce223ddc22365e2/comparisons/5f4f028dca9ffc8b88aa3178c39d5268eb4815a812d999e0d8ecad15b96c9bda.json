{"changeSetId":"turn-files-63303c156b0fccf21b889eb9cc04e1ee","changeId":"turn-file-change-4a0ca88e975c81d413e9854389323931","path":"E:/Projects/Code/AI/Ji/ji-java/web/app/src/components/ui/permission-dialog.tsx","stats":{"addedLines":31,"deletedLines":0},"before":null,"after":{"version":{"id":"captured-15bad4dce3730dd1c6c6762f407f17ec790bd0ac76f0e80baa211e7dc4b3cbdc","storageKind":"capturedBlob","contentHash":"15bad4dce3730dd1c6c6762f407f17ec790bd0ac76f0e80baa211e7dc4b3cbdc","byteLength":1131,"encoding":"utf-8","lineEnding":"lf"},"content":"import * as AlertDialog from \"@radix-ui/react-alert-dialog\"\n\nexport function PermissionDialog({\n  open,\n  tool,\n  arguments: input,\n  onDecision,\n}: {\n  open: boolean\n  tool: string\n  arguments: Record<string, unknown>\n  onDecision: (decision: \"allow\" | \"deny\") => void\n}) {\n  return (\n    <AlertDialog.Root open={open}>\n      <AlertDialog.Portal>\n        <AlertDialog.Overlay className=\"dialog-overlay\" />\n        <AlertDialog.Content className=\"dialog-content\">\n          <AlertDialog.Title>Allow tool?</AlertDialog.Title>\n          <AlertDialog.Description>\n            <strong>{tool}</strong> requests permission for <code>{JSON.stringify(input)}</code>.\n          </AlertDialog.Description>\n          <div className=\"dialog-actions\">\n            <AlertDialog.Cancel asChild><button type=\"button\" onClick={() => onDecision(\"deny\")}>Deny</button></AlertDialog.Cancel>\n            <AlertDialog.Action asChild><button type=\"button\" className=\"primary\" onClick={() => onDecision(\"allow\")}>Allow</button></AlertDialog.Action>\n          </div>\n        </AlertDialog.Content>\n      </AlertDialog.Portal>\n    </AlertDialog.Root>\n  )\n}\n"},"limitationCode":null}