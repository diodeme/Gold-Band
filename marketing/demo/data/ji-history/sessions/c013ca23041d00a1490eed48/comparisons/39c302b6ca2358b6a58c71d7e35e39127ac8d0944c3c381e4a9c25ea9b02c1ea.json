{"changeSetId":"turn-files-2c1563c3d840f037477eee911b10029c","changeId":"turn-file-change-5e1307a9a41c5a954ee77f2f00dc1b01","path":"E:/Projects/Code/AI/Ji/ji-java/web/app/src/components/ui/permission-dialog.tsx","stats":{"addedLines":24,"deletedLines":21},"before":{"version":{"id":"captured-d040094ec78e39aa99994cc7259ad9b84d6d1791b3ca5befb19d437f02341bb3","storageKind":"capturedBlob","contentHash":"d040094ec78e39aa99994cc7259ad9b84d6d1791b3ca5befb19d437f02341bb3","byteLength":1130,"encoding":"utf-8","lineEnding":"lf"},"content":"import * as AlertDialog from \"@radix-ui/react-alert-dialog\"\n\nexport function PermissionDialog({\n  open,\n  tool,\n  arguments: input,\n  onDecision,\n}: {\n  open: boolean\n  tool: string\n  arguments: Record<string, unknown>\n  onDecision: (decision: \"allow\" | \"deny\") => void\n}) {\n  return (\n    <AlertDialog.Root open={open}>\n      <AlertDialog.Portal>\n        <AlertDialog.Overlay className=\"dialog-overlay\" />\n        <AlertDialog.Content className=\"dialog-content\">\n          <AlertDialog.Title>Allow tool?</AlertDialog.Title>\n          <AlertDialog.Description>\n            <strong>{tool}</strong> requests permission for <code>{JSON.stringify(input)}</code>.\n          </AlertDialog.Description>\n          <div className=\"dialog-actions\">\n            <AlertDialog.Cancel asChild><button type=\"button\" onClick={() => onDecision(\"deny\")}>Deny</button></AlertDialog.Cancel>\n            <AlertDialog.Action asChild><button type=\"button\" className=\"primary\" onClick={() => onDecision(\"allow\")}>Allow</button></AlertDialog.Action>\n          </div>\n        </AlertDialog.Content>\n      </AlertDialog.Portal>\n    </AlertDialog.Root>\n  )\n}"},"after":{"version":{"id":"captured-85b417627024faeb3f1921cfaf3560226f41865a83d3fdb7a36e81641710b5a2","storageKind":"capturedBlob","contentHash":"85b417627024faeb3f1921cfaf3560226f41865a83d3fdb7a36e81641710b5a2","byteLength":1062,"encoding":"utf-8","lineEnding":"lf"},"content":"import {\n  AlertDialog,\n  AlertDialogAction,\n  AlertDialogCancel,\n  AlertDialogContent,\n  AlertDialogDescription,\n  AlertDialogFooter,\n  AlertDialogHeader,\n  AlertDialogTitle,\n} from \"@/components/ui/alert-dialog\"\n\nexport function PermissionDialog({ open, tool, arguments: input, onDecision }: {\n  open: boolean\n  tool: string\n  arguments: Record<string, unknown>\n  onDecision: (decision: \"allow\" | \"deny\") => void\n}) {\n  return (\n    <AlertDialog open={open}>\n      <AlertDialogContent>\n        <AlertDialogHeader>\n          <AlertDialogTitle>Allow tool?</AlertDialogTitle>\n          <AlertDialogDescription>\n            <strong>{tool}</strong> requests permission for <code>{JSON.stringify(input)}</code>.\n          </AlertDialogDescription>\n        </AlertDialogHeader>\n        <AlertDialogFooter>\n          <AlertDialogCancel onClick={() => onDecision(\"deny\")}>Deny</AlertDialogCancel>\n          <AlertDialogAction onClick={() => onDecision(\"allow\")}>Allow</AlertDialogAction>\n        </AlertDialogFooter>\n      </AlertDialogContent>\n    </AlertDialog>\n  )\n}"},"limitationCode":null}