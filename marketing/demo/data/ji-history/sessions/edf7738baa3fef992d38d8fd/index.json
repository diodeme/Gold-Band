.orElseThrow().completion().toCompletableFuture().get(1, TimeUnit.SECONDS); System.out.println(\"TERMINAL_FAILURE_COMPLETION=settled\"); } catch (Throwable failure) { System.out.println(\"TERMINAL_FAILURE_COMPLETION=\" + failure.getClass().getSimpleName()); }\nvar hash = java.util.HexFormat.of().formatHex(MessageDigest.getInstance(\"SHA-256\").digest(\"hello\".getBytes(java.nio.charset.StandardCharsets.UTF_8)));\nvar record = store.command(sessionId, \"command-terminal\", hash);\nSystem.out.println(\"TERMINAL_FAILURE_JOURNAL=\" + record.map(value -> value.status().name()).orElse(\"absent\"));\nSystem.out.println(\"TERMINAL_FAILURE_ACTIVE=\" + sessions.hasActiveRun(sessionId));\nsessions.close();\nvar normalProvider = new ScriptedModelProvider(); var normalStore = new io.github.diodeme.ji.session.memory.MemorySessionStore();\nvar closedRuntime = new AgentRuntimeBuilder().provider(normalProvider).sessionStore(normalStore).build(); closedRuntime.close();\ntry { closedRuntime.newSession(new SessionOptions(new ModelRef(\"faux\", \"faux-1\"), \".\")); System.out.println(\"CLOSED_RUNTIME=accepted\"); } catch (Throwable failure) { System.out.println(\"CLOSED_RUNTIME=\" + failure.getClass().getName() + \":\" + failure.getMessage()); }\nvar closedOpenAi = io.github.diodeme.ji.provider.openai.OpenAiProvider.builder().baseUrl(\"http://127.0.0.1:1\").build(); closedOpenAi.close();\nvar cancel = new io.github.diodeme.ji.ai.CancellationSource();\nvar request = new ModelRequest(\"session-1\", new ModelRef(\"openai\", \"model\"), \"\", List.of(), List.of(), Map.of(), cancel.token());\ntry { closedOpenAi.stream(request); System.out.println(\"CLOSED_PROVIDER=accepted\"); } catch (Throwable failure) { System.out.println(\"CLOSED_PROVIDER=\" + failure.getClass().getName() + \":\" + failure.getMessage()); }\n/exit\n'@ | jshell --class-path $probeCp","status":"completed","startedSeq":4731,"endedSeq":5406,"startedAt":"1788466253Z","endedAt":"1788466256Z","raw":{"goldBandActivity":{"activit