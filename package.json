{
  "name": "gold-band-desktop",
  "version": "0.12.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-channel.mjs default",
    "dev:default": "node scripts/dev-channel.mjs default",
    "dev:static": "node scripts/dev-static-channel.mjs default",
    "dev:wb": "node scripts/dev-channel.mjs wb",
    "build": "node scripts/build-channel.mjs default",
    "build:channel": "node scripts/build-channel.mjs",
    "build:default": "node scripts/build-channel.mjs default",
    "build:wb": "node scripts/build-channel.mjs wb",
    "version:sync": "node scripts/sync-version.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "web:dev": "vite --config web/vite.config.ts --host 127.0.0.1 --port 1420",
    "web:test": "vitest run --config web/vitest.config.ts",
    "test:channel-config": "node --test scripts/channel-config.test.mjs",
    "test:dev-watch-config": "node --test scripts/dev-watch-config.test.mjs",
    "test:dev-static": "node --test scripts/dev-static-channel.test.mjs",
    "test:macos-signing": "node --test scripts/configure-macos-signing.test.mjs",
    "web:build": "tsc -p web/tsconfig.build.json && vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "agent-catalog:refresh": "node scripts/prepare-agent-catalog.mjs",
    "agent-catalog:offline": "node scripts/prepare-agent-catalog.mjs --offline",
    "test:agent-catalog": "node --test scripts/prepare-agent-catalog.test.mjs"
  },
  "dependencies": {
    "@atomic-editor/editor": "0.6.2",
